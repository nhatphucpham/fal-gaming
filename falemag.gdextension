[configuration]

entry_symbol = "falemag_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://bin/libfalemag.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libfalemag.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libfalemag.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libfalemag.windows.template_release.x86_64.dll"
android.debug.arm64 = "res://bin/libfalemag.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/libfalemag.android.template_release.arm64.so"
android.debug.arm32 = "res://bin/libfalemag.android.template_debug.arm32.so"
android.release.arm32 = "res://bin/libfalemag.android.template_release.arm32.so"
web.debug.wasm32 = "res://bin/libfalemag.web.template_debug.wasm32.nothreads.wasm"
web.release.wasm32 = "res://bin/libfalemag.web.template_release.wasm32.nothreads.wasm"

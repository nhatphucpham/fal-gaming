[gd_resource type="Resource" script_class="EncounterData" format=3]

[ext_resource type="Script" path="res://Systems/Run/encounter_effect.gd" id="1_effect"]
[ext_resource type="Script" path="res://Systems/Run/encounter_option.gd" id="2_option"]
[ext_resource type="Script" path="res://Systems/Run/encounter_data.gd" id="3_data"]

[sub_resource type="Resource" id="effect_1"]
script = ExtResource("1_effect")
kind = &"gain.supply"
amount = -4

[sub_resource type="Resource" id="effect_2"]

kind = &"gain.gold"
amount = 7

[sub_resource type="Resource" id="option_0"]
script = ExtResource("2_option")
title_key = "ENCOUNTER_SURPLUS_A"
effects = Array[ExtResource("1_effect")]([SubResource("effect_1"), SubResource("effect_2")])

[sub_resource type="Resource" id="effect_3"]

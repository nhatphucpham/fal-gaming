[gd_resource type="Resource" script_class="EncounterData" format=3]

[ext_resource type="Script" path="res://Systems/Run/encounter_effect.gd" id="1_effect"]
[ext_resource type="Script" path="res://Systems/Run/encounter_option.gd" id="2_option"]
[ext_resource type="Script" path="res://Systems/Run/encounter_data.gd" id="3_data"]

[sub_resource type="Resource" id="effect_1"]
script = ExtResource("1_effect")
kind = &"gain.free_refreshes"
amount = 2

[sub_resource type="Resource" id="effect_2"]
script = ExtResource("1_effect")
kind = &"gain.gold"
amount = 2

[sub_resource type="Resource" id="option_0"]
script = ExtResource("2_option")
title_key = "ENCOUNTER_STRANGER_A"
effects = Array[ExtResource("1_effect")]([SubResource("effect_1"), SubResource("effect_2")])

[sub_resource type="Resource" id="effect_3"]
script = ExtResource("1_effect")
kind = &"gain.free_unit"
amount = 2

[sub_resource type="Resource" id="option_1"]
script = ExtResource("2_option")
title_key = "ENCOUNTER_STRANGER_B"
effects = Array[ExtResource("1_effect")]([SubResource("effect_3")])

[resource]
script = ExtResource("3_data")
id = &"encounter.stranger"
name_key = "ENCOUNTER_STRANGER"
speaker = &"unit.blade_wanderer"
line_keys = Array[String](["ENCOUNTER_STRANGER_LINE_1", "ENCOUNTER_STRANGER_LINE_2", "ENCOUNTER_STRANGER_LINE_3"])
line_speakers = Array[int]([1, 1, 0])
options = Array[ExtResource("2_option")]([SubResource("option_0"), SubResource("option_1")])

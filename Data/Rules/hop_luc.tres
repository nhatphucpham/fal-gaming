scope = &"scope.side"
value = 30

[sub_resource type="SynergyTierData" id="tier_5"]
at = 15
description_key = "HOP_LUC_15"
modifiers = Array[ModifierData]([SubResource("mod_5")])

[resource]
formation_level_step_pct = 40
max_formation_level = 4
tiers = Array[SynergyTierData]([SubResource("tier_1"), SubResource("tier_2"), SubResource("tier_3"), SubResource("tier_4"), SubResource("tier_5")])

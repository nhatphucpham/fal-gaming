[gd_resource type="TacticsLeaderData" format=3]

[ext_resource type="UnitData" path="res://Data/Units/pike_guard.tres" id="base_unit"]
[ext_resource type="ClassData" path="res://Data/Classes/spear.tres" id="base_class"]
[ext_resource type="TacticsKeywordData" path="res://Data/Tactics/Keywords/long_weapon.tres" id="kw_long_weapon"]
[ext_resource type="TacticsPassiveData" path="res://Data/Tactics/Passives/drilled_ranks.tres" id="passive_drilled_ranks"]
[ext_resource type="TacticsSkillData" path="res://Data/Tactics/Skills/piercing_thrust.tres" id="skill"]
[ext_resource type="TacticsTroopData" path="res://Data/Tactics/Troops/spearman.tres" id="troop_spearman"]
[ext_resource type="TacticsTroopData" path="res://Data/Tactics/Troops/shieldman.tres" id="troop_shieldman"]
[ext_resource type="TacticsTroopData" path="res://Data/Tactics/Troops/archer.tres" id="troop_archer"]
[ext_resource type="TacticsTraitData" path="res://Data/Tactics/Traits/strict.tres" id="trait_strict"]

[resource]
id = &"leader.do_uy"
name_key = "LEADER_DO_UY"
base_unit = ExtResource("base_unit")
base_class = ExtResource("base_class")
hp_pct = 150
attack_pct = 115
min_range_cells = 1
max_range_cells = 1
move_points = 4
vision_cells = 5
keywords = Array[TacticsKeywordData]([ExtResource("kw_long_weapon")])
lead_capacity = 3
passives = Array[TacticsPassiveData]([ExtResource("passive_drilled_ranks")])
skill = ExtResource("skill")
default_order = &"order.follow"
squad = Array[TacticsTroopData]([ExtResource("troop_spearman"), ExtResource("troop_shieldman"), ExtResource("troop_archer")])
traits = Array[TacticsTraitData]([ExtResource("trait_strict")])

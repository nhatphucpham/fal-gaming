[gd_resource type="TacticsLeaderData" format=3]

[ext_resource type="UnitData" path="res://Data/Units/moon_spear.tres" id="base_unit"]
[ext_resource type="ClassData" path="res://Data/Classes/spear.tres" id="base_class"]
[ext_resource type="TacticsKeywordData" path="res://Data/Tactics/Keywords/long_weapon.tres" id="kw_long_weapon"]
[ext_resource type="TacticsPassiveData" path="res://Data/Tactics/Passives/hook_spear.tres" id="passive_hook_spear"]
[ext_resource type="TacticsSkillData" path="res://Data/Tactics/Skills/piercing_thrust.tres" id="skill"]
[ext_resource type="TacticsTroopData" path="res://Data/Tactics/Troops/spearman.tres" id="troop_spearman"]
[ext_resource type="TacticsTroopData" path="res://Data/Tactics/Troops/swordsman.tres" id="troop_swordsman"]
[ext_resource type="TacticsTroopData" path="res://Data/Tactics/Troops/rider.tres" id="troop_rider"]
[ext_resource type="TacticsTraitData" path="res://Data/Tactics/Traits/strict.tres" id="trait_strict"]

[resource]
id = &"leader.moon_spear"
name_key = "LEADER_MOON_SPEAR"
base_unit = ExtResource("base_unit")
base_class = ExtResource("base_class")
hp_pct = 150
attack_pct = 120
min_range_cells = 1
max_range_cells = 2
move_points = 4
vision_cells = 5
keywords = Array[TacticsKeywordData]([ExtResource("kw_long_weapon")])
lead_capacity = 3
passives = Array[TacticsPassiveData]([ExtResource("passive_hook_spear")])
skill = ExtResource("skill")
default_order = &"order.vanguard"
squad = Array[TacticsTroopData]([ExtResource("troop_spearman"), ExtResource("troop_swordsman"), ExtResource("troop_rider")])
traits = Array[TacticsTraitData]([ExtResource("trait_strict")])

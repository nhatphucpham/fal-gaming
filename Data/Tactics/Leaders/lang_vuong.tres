[gd_resource type="TacticsLeaderData" format=3]

[ext_resource type="UnitData" path="res://Data/Units/wolf_king_shield.tres" id="base_unit"]
[ext_resource type="ClassData" path="res://Data/Classes/shield.tres" id="base_class"]
[ext_resource type="TacticsPassiveData" path="res://Data/Tactics/Passives/pack_fury.tres" id="passive_pack_fury"]
[ext_resource type="TacticsSkillData" path="res://Data/Tactics/Skills/rally_banner.tres" id="skill"]
[ext_resource type="TacticsTroopData" path="res://Data/Tactics/Troops/shieldman.tres" id="troop_shieldman"]
[ext_resource type="TacticsTroopData" path="res://Data/Tactics/Troops/spearman.tres" id="troop_spearman"]
[ext_resource type="TacticsTroopData" path="res://Data/Tactics/Troops/archer.tres" id="troop_archer"]
[ext_resource type="TacticsTraitData" path="res://Data/Tactics/Traits/strict.tres" id="trait_strict"]

[resource]
id = &"leader.lang_vuong"
name_key = "LEADER_LANG_VUONG"
base_unit = ExtResource("base_unit")
base_class = ExtResource("base_class")
hp_pct = 220
attack_pct = 130
min_range_cells = 1
max_range_cells = 1
move_points = 4
vision_cells = 5
keywords = Array[TacticsKeywordData]([])
lead_capacity = 4
passives = Array[TacticsPassiveData]([ExtResource("passive_pack_fury")])
skill = ExtResource("skill")
default_order = &"order.follow"
squad = Array[TacticsTroopData]([ExtResource("troop_shieldman"), ExtResource("troop_spearman"), ExtResource("troop_archer"), ExtResource("troop_spearman")])
traits = Array[TacticsTraitData]([ExtResource("trait_strict")])

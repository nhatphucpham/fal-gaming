[gd_resource type="Resource" script_class="TacticsRegionData" format=3]

[ext_resource type="Script" path="res://Systems/Tactics/tactics_region_data.gd" id="script"]
[ext_resource type="Script" path="res://Systems/Tactics/tactics_offer_data.gd" id="offer_script"]
[ext_resource type="TacticsScenarioData" path="res://Data/Tactics/Scenarios/river_crossing.tres" id="scenario"]
[ext_resource type="TacticsTroopData" path="res://Data/Tactics/Troops/militia.tres" id="troop_militia"]
[ext_resource type="TacticsTroopData" path="res://Data/Tactics/Troops/spearman.tres" id="troop_spearman"]

[sub_resource type="Resource" id="offer_0"]
script = ExtResource("offer_script")
kind = &"offer.hire"
troop = ExtResource("troop_militia")
price = 2
stock = 2

[sub_resource type="Resource" id="offer_1"]
script = ExtResource("offer_script")
kind = &"offer.hire"
troop = ExtResource("troop_spearman")
price = 3
stock = 1

[sub_resource type="Resource" id="offer_2"]
script = ExtResource("offer_script")
kind = &"offer.heal"
price = 2
stock = 2

[resource]
script = ExtResource("script")
id = &"region.ferry"
name_key = "REGION_FERRY"
scenario = ExtResource("scenario")
map_position = Vector2(0.27, 0.66)
neighbours = Array[StringName]([&"region.old_citadel", &"region.horse_post"])
market_name_key = "MARKET_FERRY"
offers = Array[ExtResource("offer_script")]([SubResource("offer_0"), SubResource("offer_1"), SubResource("offer_2")])
auto_enemy_pct = 93
auto_supplies = 1

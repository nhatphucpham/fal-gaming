[gd_resource type="Resource" script_class="TacticsRegionData" format=3]

[ext_resource type="Script" path="res://Systems/Tactics/tactics_region_data.gd" id="script"]
[ext_resource type="Script" path="res://Systems/Tactics/tactics_offer_data.gd" id="offer_script"]
[ext_resource type="TacticsScenarioData" path="res://Data/Tactics/Scenarios/supply_road.tres" id="scenario"]
[ext_resource type="TacticsTroopData" path="res://Data/Tactics/Troops/rider.tres" id="troop_rider"]
[ext_resource type="Resource" path="res://Data/Tactics/World/Items/herb_kit.tres" id="item_herb_kit"]

[sub_resource type="Resource" id="offer_0"]
script = ExtResource("offer_script")
kind = &"offer.hire"
troop = ExtResource("troop_rider")
price = 4
stock = 1

[sub_resource type="Resource" id="offer_1"]
script = ExtResource("offer_script")
kind = &"offer.heal"
price = 2
stock = 1

[sub_resource type="Resource" id="offer_2"]
script = ExtResource("offer_script")
kind = &"offer.item"
item = ExtResource("item_herb_kit")
price = 2
stock = 2

[resource]
script = ExtResource("script")
id = &"region.horse_post"
name_key = "REGION_HORSE_POST"
scenario = ExtResource("scenario")
map_position = Vector2(0.72, 0.4)
neighbours = Array[StringName]([&"region.siege_pass"])
market_name_key = "MARKET_HORSE_POST"
offers = Array[ExtResource("offer_script")]([SubResource("offer_0"), SubResource("offer_1"), SubResource("offer_2")])
auto_enemy_pct = 104
auto_supplies = 1

[resource]
script = ExtResource("script")
id = &"region.old_citadel"
name_key = "REGION_OLD_CITADEL"
scenario = ExtResource("scenario")
map_position = Vector2(0.24, 0.36)
neighbours = Array[StringName]([&"region.siege_pass"])
market_name_key = "MARKET_OLD_CITADEL"

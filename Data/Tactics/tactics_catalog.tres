[resource]
rules = ExtResource("rules")
terrains = Array[TacticsTerrainData]([ExtResource("terrains_plain"), ExtResource("terrains_forest"), ExtResource("terrains_hill"), ExtResource("terrains_river"), ExtResource("terrains_ford"), ExtResource("terrains_bridge"), ExtResource("terrains_fort"), ExtResource("terrains_village")])
keywords = Array[TacticsKeywordData]([ExtResource("keywords_long_weapon"), ExtResource("keywords_charge"), ExtResource("keywords_armor_pierce"), ExtResource("keywords_cover"), ExtResource("keywords_flying"), ExtResource("keywords_heavy"), ExtResource("keywords_scout")])
zones = Array[TacticsZoneData]([ExtResource("zones_wind"), ExtResource("zones_fire")])
passives = Array[TacticsPassiveData]([ExtResource("passives_iron_will"), ExtResource("passives_pack_fury"), ExtResource("passives_forest_ambush"), ExtResource("passives_drilled_ranks"), ExtResource("passives_wind_trail"), ExtResource("passives_hook_spear"), ExtResource("passives_warlord_growth"), ExtResource("passives_mark_rescue"), ExtResource("passives_mark_stand"), ExtResource("passives_mark_surge"), ExtResource("passives_mark_discontent"), ExtResource("passives_mark_riot"), ExtResource("passives_mark_flee"), ExtResource("passives_mark_betray")])
skills = Array[TacticsSkillData]([ExtResource("skills_rally_banner"), ExtResource("skills_piercing_thrust"), ExtResource("skills_chain_arrows"), ExtResource("skills_fire_rain"), ExtResource("skills_blood_oath"), ExtResource("skills_named_rally")])
troops = Array[TacticsTroopData]([ExtResource("troops_spearman"), ExtResource("troops_shieldman"), ExtResource("troops_archer"), ExtResource("troops_rider"), ExtResource("troops_swordsman"), ExtResource("troops_kite_scout")])
leaders = Array[TacticsLeaderData]([ExtResource("leaders_lac_hong"), ExtResource("leaders_moon_spear"), ExtResource("leaders_lieu_mi"), ExtResource("leaders_ba_khac"), ExtResource("leaders_thiet_nha"), ExtResource("leaders_lang_vuong")])
maps = Array[TacticsMapData]([ExtResource("maps_river_crossing"), ExtResource("maps_night_raid")])
scenarios = Array[TacticsScenarioData]([ExtResource("scenarios_river_crossing"), ExtResource("scenarios_night_raid")])
traits = Array[TacticsTraitData]([ExtResource("traits_strict"), ExtResource("traits_kind")])
weathers = Array[TacticsWeatherData]([ExtResource("weathers_clear"), ExtResource("weathers_rain"), ExtResource("weathers_fog"), ExtResource("weathers_wind")])
daytimes = Array[TacticsDaytimeData]([ExtResource("daytimes_day"), ExtResource("daytimes_dusk"), ExtResource("daytimes_night")])
incident_rules = ExtResource("incident_rules")

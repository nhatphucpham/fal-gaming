[gd_resource type="TacticsTroopData" format=3]

[ext_resource type="UnitData" path="res://Data/Units/spearman.tres" id="base_unit"]
[ext_resource type="ClassData" path="res://Data/Classes/spear.tres" id="base_class"]
[ext_resource type="TacticsKeywordData" path="res://Data/Tactics/Keywords/long_weapon.tres" id="kw_long_weapon"]

[resource]
id = &"troop.spearman"
name_key = "TROOP_SPEARMAN"
base_unit = ExtResource("base_unit")
base_class = ExtResource("base_class")
hp_pct = 40
attack_pct = 100
min_range_cells = 1
max_range_cells = 1
move_points = 4
vision_cells = 4
keywords = Array[TacticsKeywordData]([ExtResource("kw_long_weapon")])

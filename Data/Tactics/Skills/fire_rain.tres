[gd_resource type="TacticsSkillData" format=3]

[ext_resource type="TacticsZoneData" path="res://Data/Tactics/Zones/fire.tres" id="zone"]

[sub_resource type="TacticsSkillEffectData" id="effect_1"]
handler = &"skill_effect.damage"
coefficient_pct = 80
damage_kind = 1

[sub_resource type="TacticsSkillEffectData" id="effect_2"]
handler = &"skill_effect.create_zone"
duration_rounds = 2
zone = ExtResource("zone")

[resource]
id = &"tactics_skill.fire_rain"
name_key = "TACTICS_SKILL_FIRE_RAIN"
description_key = "TACTICS_SKILL_FIRE_RAIN_DESC"
charge = &"charge.damage_taken"
charge_threshold = 300
target = &"skill_target.area"
cast_range_cells = 4
area_radius_cells = 1
effects = Array[TacticsSkillEffectData]([SubResource("effect_1"), SubResource("effect_2")])

units = Array[UnitData]([ExtResource("unit_shield_guard"), ExtResource("unit_blade_wanderer"), ExtResource("unit_wolf_spear"), ExtResource("unit_wolf_rider"), ExtResource("unit_archer"), ExtResource("unit_fire_adept"), ExtResource("unit_wolf_shield"), ExtResource("unit_wolf_blade"), ExtResource("unit_spearman"), ExtResource("unit_light_rider"), ExtResource("unit_wolf_archer"), ExtResource("unit_ice_mage"), ExtResource("unit_iron_guard"), ExtResource("unit_blood_wolf"), ExtResource("unit_wolf_marksman"), ExtResource("unit_wind_mage"), ExtResource("unit_pike_guard"), ExtResource("unit_wolf_king_shield"), ExtResource("unit_heavy_rider"), ExtResource("unit_moon_spear"), ExtResource("unit_thunder_mage"), ExtResource("unit_lieu_mi"), ExtResource("unit_ba_khac"), ExtResource("unit_lac_hong"), ExtResource("unit_thiet_nha")])
battle_rules = ExtResource("rules_battle")
run_rules = ExtResource("rules_run")
stages = Array[ExtResource("2_stage_data")]([ExtResource("stage_01"), ExtResource("stage_02"), ExtResource("stage_03"), ExtResource("stage_04"), ExtResource("stage_05"), ExtResource("stage_06"), ExtResource("stage_07"), ExtResource("stage_08"), ExtResource("stage_09"), ExtResource("stage_10"), ExtResource("stage_11"), ExtResource("stage_12")])

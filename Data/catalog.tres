[resource]
script = ExtResource("1_catalog")
classes = Array[ClassData]([ExtResource("class_shield"), ExtResource("class_sword"), ExtResource("class_spear"), ExtResource("class_cavalry"), ExtResource("class_archer"), ExtResource("class_mage"), ExtResource("class_colossus")])
skills = Array[SkillData]([ExtResource("skill_hold_ground"), ExtResource("skill_sweep"), ExtResource("skill_heart_pierce"), ExtResource("skill_breakthrough"), ExtResource("skill_arrow_rain"), ExtResource("skill_arcane_circle")])
passives = Array[PassiveData]([ExtResource("passive_bedrock"), ExtResource("passive_riposte"), ExtResource("passive_brace"), ExtResource("passive_momentum"), ExtResource("passive_steady_aim"), ExtResource("passive_spirit_draw"), ExtResource("passive_hoa_da")])
units = Array[UnitData]([ExtResource("unit_shield_guard"), ExtResource("unit_blade_wanderer"), ExtResource("unit_wolf_spear"), ExtResource("unit_wolf_rider"), ExtResource("unit_archer"), ExtResource("unit_fire_adept"), ExtResource("unit_wolf_shield"), ExtResource("unit_wolf_blade"), ExtResource("unit_spearman"), ExtResource("unit_light_rider"), ExtResource("unit_wolf_archer"), ExtResource("unit_ice_mage"), ExtResource("unit_iron_guard"), ExtResource("unit_blood_wolf"), ExtResource("unit_wolf_marksman"), ExtResource("unit_wind_mage"), ExtResource("unit_pike_guard"), ExtResource("unit_wolf_king_shield"), ExtResource("unit_heavy_rider"), ExtResource("unit_moon_spear"), ExtResource("unit_thunder_mage"), ExtResource("unit_lieu_mi"), ExtResource("unit_ba_khac"), ExtResource("unit_lac_hong"), ExtResource("unit_thiet_nha"), ExtResource("unit_boss_cu_nham")])
battle_rules = ExtResource("rules_battle")
run_rules = ExtResource("rules_run")
stages = Array[ExtResource("2_stage_data")]([ExtResource("stage_01"), ExtResource("stage_02"), ExtResource("stage_03"), ExtResource("stage_04"), ExtResource("stage_05"), ExtResource("stage_06"), ExtResource("stage_07"), ExtResource("stage_08"), ExtResource("stage_09"), ExtResource("stage_10"), ExtResource("stage_11"), ExtResource("stage_12")])
formations = Array[FormationData]([ExtResource("formation_shield_wall"), ExtResource("formation_arrow_rain"), ExtResource("formation_spell_guard"), ExtResource("formation_spearhead"), ExtResource("formation_twin_blades"), ExtResource("formation_spear_cover"), ExtResource("formation_wild_geese"), ExtResource("formation_long_serpent"), ExtResource("formation_square"), ExtResource("formation_crane_wings"), ExtResource("formation_fish_scales"), ExtResource("formation_three_powers")])
milestones = Array[MilestoneData]([ExtResource("milestone_class_shield"), ExtResource("milestone_class_sword"), ExtResource("milestone_class_spear"), ExtResource("milestone_class_cavalry"), ExtResource("milestone_class_archer"), ExtResource("milestone_class_mage"), ExtResource("milestone_race_human"), ExtResource("milestone_race_wolf")])
hop_luc = ExtResource("rules_hop_luc")
epiphanies = Array[ExtResource("3_epiphany_family")]([ExtResource("epiphany_shield"), ExtResource("epiphany_sword"), ExtResource("epiphany_spear"), ExtResource("epiphany_cavalry"), ExtResource("epiphany_archer"), ExtResource("epiphany_mage"), ExtResource("epiphany_human"), ExtResource("epiphany_wolf")])
encounters = Array[ExtResource("4_encounter_data")]([ExtResource("encounter_merchants"), ExtResource("encounter_wager"), ExtResource("encounter_deserters"), ExtResource("encounter_villagers"), ExtResource("encounter_stranger"), ExtResource("encounter_surplus"), ExtResource("encounter_teacher"), ExtResource("encounter_storehouse")])
sounds = ExtResource("audio_sounds")

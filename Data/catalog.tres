script = ExtResource("1_catalog")
classes = Array[ClassData]([ExtResource("class_shield"), ExtResource("class_sword"), ExtResource("class_spear"), ExtResource("class_cavalry"), ExtResource("class_archer"), ExtResource("class_mage")])

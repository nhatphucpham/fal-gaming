[gd_resource type="Resource" script_class="StageData" format=3]

[ext_resource type="Script" path="res://Systems/Run/stage_data.gd" id="1_stage"]
[ext_resource type="Script" path="res://Systems/Lineup/lineup_slot.gd" id="2_slot"]

[sub_resource type="Resource" id="Slot_1"]
script = ExtResource("2_slot")
unit_id = &"unit.wolf_blade"
star = 1
local_col = 3
local_rank = 1

[sub_resource type="Resource" id="Slot_2"]
script = ExtResource("2_slot")
unit_id = &"unit.spearman"
star = 1
local_col = 5
local_rank = 1

[resource]
script = ExtResource("1_stage")
id = &"stage.01"
name_key = "STAGE_01"
slots = Array[ExtResource("2_slot")]([SubResource("Slot_1"), SubResource("Slot_2")])
